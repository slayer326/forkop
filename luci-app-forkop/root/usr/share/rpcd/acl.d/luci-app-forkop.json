{
  "luci-app-forkop": {
    "description": "Grant UCI and RPC access to LuCI app Forkop",
    "read": {
      "file": {
        "/usr/libexec/forkop-ro get_status": ["exec"],
        "/usr/libexec/forkop-ro get_sing_box_status": ["exec"],
        "/usr/libexec/forkop-ro get_system_info": ["exec"],
        "/usr/libexec/forkop-ro get_ui_capabilities": ["exec"],
        "/usr/libexec/forkop-ro get_ui_state": ["exec"],
        "/usr/libexec/forkop-ro get_health_status": ["exec"],
        "/usr/libexec/forkop-ro get_history": ["exec"],
        "/usr/libexec/forkop-ro route_trace *": ["exec"],
        "/usr/libexec/forkop-ro config_snapshot_list": ["exec"],
        "/usr/libexec/forkop-ro config_snapshot_diff *": ["exec"],
        "/usr/libexec/forkop-ro connectivity_test *": ["exec"],
        "/usr/libexec/forkop-ro get_readonly_config_sections": ["exec"],
        "/usr/libexec/forkop-ro get_dashboard_runtime_metadata": ["exec"],
        "/usr/libexec/forkop-ro show_version": ["exec"],
        "/usr/libexec/forkop-ro check_nft_rules": ["exec"],
        "/usr/libexec/forkop-ro check_sing_box": ["exec"],
        "/usr/libexec/forkop-ro check_logs": ["exec"],
        "/usr/libexec/forkop-ro check_fakeip": ["exec"],
        "/usr/libexec/forkop-ro check_dns_available": ["exec"],
        "/usr/libexec/forkop-ro clash_api get_proxies": ["exec"],
        "/usr/libexec/forkop-ro clash_api get_connections": ["exec"],
        "/usr/libexec/forkop-ro service_action_status *": ["exec"],
        "/usr/libexec/forkop-ro latency_test_status *": ["exec"],
        "/usr/libexec/forkop-ro component_action_status *": ["exec"],
        "/usr/libexec/forkop-ro subscription_update_status *": ["exec"],
        "/usr/libexec/forkop-ro component_update_check_cache": ["exec"],
        "/var/run/forkop/component-actions/*": [
          "read"
        ],
        "/tmp/run/forkop/component-actions/*": [
          "read"
        ],
        "/var/run/forkop/ui-state/*": [
          "read"
        ],
        "/tmp/run/forkop/ui-state/*": [
          "read"
        ],
        "/var/run/forkop/ui-state/service-actions/*": [
          "read"
        ],
        "/tmp/run/forkop/ui-state/service-actions/*": [
          "read"
        ],
        "/var/run/forkop/ui-state/latency-actions/*": [
          "read"
        ],
        "/tmp/run/forkop/ui-state/latency-actions/*": [
          "read"
        ],
        "/usr/libexec/forkop-ro global_check masked": ["exec"],
        "/usr/libexec/forkop-ro show_sing_box_config masked": ["exec"]
      },
      "ubus": {
        "file": [
          "exec"
        ],
        "luci-rpc": [
          "getDHCPLeases",
          "getHostHints"
        ],
        "network.interface": [
          "dump"
        ]
      }
    },
    "write": {
      "file": {
        "/usr/bin/forkop": ["exec"],
        "/etc/init.d/forkop": ["exec"],
        "/etc/sing-box/config.json": ["read"],
        "/tmp/sing-box/config.json": ["read"],
        "/var/run/forkop/section-cache/*": ["read"],
        "/tmp/run/forkop/section-cache/*": ["read"],
        "/var/run/forkop/ui-state/*": [
          "write"
        ],
        "/tmp/run/forkop/ui-state/*": [
          "write"
        ],
        "/var/run/forkop/ui-state/service-actions/*": [
          "write"
        ],
        "/tmp/run/forkop/ui-state/service-actions/*": [
          "write"
        ],
        "/var/run/forkop/ui-state/latency-actions/*": [
          "write"
        ],
        "/tmp/run/forkop/ui-state/latency-actions/*": [
          "write"
        ]
      },
      "uci": [
        "forkop"
      ]
    }
  },
  "luci-app-forkop-admin": {
    "description": "Grant Forkop configuration read access to administrators",
    "read": {
      "uci": ["forkop"]
    }
  }
}
