msgstr "Пакет ByeDPI установлен"

msgid "ByeDPI package is not installed"
msgstr "Пакет ByeDPI не установлен"

msgid "ByeDPI provider binary is available"
msgstr "Бинарный файл провайдера ByeDPI доступен"

msgid "ByeDPI provider binary is not available"
msgstr "Бинарный файл провайдера ByeDPI недоступен"

