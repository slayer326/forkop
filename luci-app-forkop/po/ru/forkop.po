msgid "%s (disabled)"
msgstr "%s (отключена)"

msgid "%s (not installed)"
msgstr "%s (не установлен)"

msgid "%s (provider not installed)"
msgstr "%s (провайдер не установлен)"

msgid "%s (unavailable)"
msgstr "%s (недоступна)"

msgid "%s in the rule \"%t\""
msgstr "%s в правиле «%t»"

