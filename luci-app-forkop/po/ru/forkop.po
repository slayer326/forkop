msgstr "Все оставшиеся серверы"

msgid "All remaining servers means every server not already assigned to a higher-priority level."
msgstr "Добавляет все серверы, которые не попали в уровни с более высоким приоритетом."

msgid "All servers"
msgstr "Все серверы"

msgid "All traffic from these IP addresses will be routed through the section unconditionally, ignoring all other conditions."
msgstr "Весь трафик с этих IP-адресов будет направлен через секцию безусловно, игнорируя остальные условия."

msgid "All traffic: %d"
msgstr "Весь трафик: %d"

msgid "Allowed domain prefixes are full:, keyword:, and regex:"
msgstr "Разрешённые префиксы доменов: full:, keyword: и regex:"

msgid "Allows access to YACD from the WAN. Make sure to open the appropriate port in your firewall."
msgstr "Обеспечивает доступ к YACD из WAN. Убедитесь, что в брандмауэре открыт соответствующий порт."

msgid "Allows limiting the list of servers for URLTest"
msgstr "Позволяет ограничить список серверов для URLTest"

msgid "An administrator can roll it back."
msgstr "Откатить его может администратор."

msgid "an earlier rule re-resolves the address, so the route depends on its answer"
msgstr "раньше стоит правило, которое заново разрешает адрес, поэтому маршрут зависит от его ответа"

msgid "an earlier rule uses a list or pattern whose contents cannot be checked here"
msgstr "раньше стоит правило со списком или шаблоном, содержимое которого здесь не проверить"

msgid "An interrupted package update is being recovered. Avoid changes until it completes."
msgstr "Восстанавливается прерванное обновление пакетов. Не вносите изменений, пока оно не завершится."

msgid "An IP address needs no DNS"
msgstr "Для IP-адреса DNS не нужен"

msgid "and %d more"
msgstr "и ещё %d"

msgid "Anime"
msgstr "Аниме"

msgid "Another autotune operation is running."
msgstr "Уже выполняется другая операция автоподбора."

msgid "another check is running"
msgstr "идёт другая проверка"

msgid "Another check was running."
msgstr "Шла другая проверка."

msgid "Another group was changed in this run; at most one change per run."
msgstr "В этой проверке уже изменена другая группа; не больше одного изменения за проверку."

msgid "Another snapshot operation is already in progress. Changes were not applied; try again in a moment."
msgstr "Уже выполняется другая операция со снимками. Изменения не применены, повторите через минуту."

msgid "Another snapshot operation is already in progress. Try again in a moment."
msgstr "Уже выполняется другая операция со снимками. Повторите через минуту."

msgid "Answer of the router DNS"
msgstr "Ответ DNS роутера"

msgid "Any device"
msgstr "Любое устройство"

msgid "Applied, check passed"
msgstr "Применена, проверка пройдена"

msgid "Apply"
msgstr "Применить"

msgid "Apply %s"
msgstr "Применить %s"

msgid "Apply %s?"
msgstr "Применить %s?"

msgid "Apply did not finish: configuration edited"
msgstr "Применение не завершено: конфигурацию изменили"

msgid "Apply section rules only to the specified local IP addresses"
msgstr "Применять правила секции только к указанным локальным IP-адресам"

msgid "Applying a strategy"
msgstr "Применяется стратегия"

msgid "Applying changes…"
msgstr "Применяются изменения…"

msgid "Applying Forkop configuration…"
msgstr "Применение конфигурации Forkop…"

msgid "Applying the new strategy did not finish: its reload did not succeed, and the configuration was changed meanwhile. Forkop X kept that change instead of rolling back. Check the rule, or restore the snapshot you need in History and recovery."
msgstr "Применение новой стратегии не завершено: её перезагрузка не удалась, а конфигурацию тем временем изменили. Forkop X сохранил это изменение вместо отката. Проверьте правило или восстановите нужный снимок в разделе «История и восстановление»."

msgid "Applying…"
msgstr "Применение…"

msgid "Apps reconnect on their own; downloads and calls may drop"
msgstr "Приложения переподключатся сами; загрузки и звонки могут оборваться"

msgid "At least one valid domain must be specified."
msgstr "Нужно указать хотя бы один корректный домен."

msgid "At least one valid IP or subnet must be specified."
msgstr "Нужно указать хотя бы один корректный IP-адрес или подсеть."

msgid "At most %d change(s) per day; a rolled back strategy waits %s."
msgstr "Не больше %d изменений в сутки; откаченная стратегия ждёт %s."

msgid "Auto refresh"
msgstr "Автообновление"

msgid "Automatic"
msgstr "Автоматически"

msgid "Automatic applies are disabled by the policy (0 per day)."
msgstr "Автоматические изменения отключены политикой (0 в сутки)."

msgid "Automatic apply requires high confidence."
msgstr "Для автоматического применения нужна высокая уверенность."

msgid "Automatic changes per day"
msgstr "Автоизменений в сутки"

msgid "Automatic component update checks"
msgstr "Автоматическая проверка обновлений компонентов"

msgid "Automatic recovery did not finish."
msgstr "Автоматическое восстановление не завершилось."

msgid "Automatically"
msgstr "Автоматически"

msgid "Automatically add text to the name of each server from this subscription for convenient filtering."
msgstr "Автоматически добавлять текст к имени каждого сервера из этой подписки для удобной фильтрации."

msgid "Automatically check installed components for new versions"
msgstr "Автоматически проверять наличие новых версий установленных компонентов"

msgid "Automatically select the fastest node in the current level"
msgstr "Автовыбор самого быстрого узла уровня"

msgid "Autostart is off"
msgstr "Автозапуск выключен"

msgid "Autostart is on"
msgstr "Автозапуск включён"

msgid "Autotune"
msgstr "Автоподбор"

msgid "Autotune apply"
msgstr "Применение автоподбора"

msgid "Autotune checks only the sites listed here."
msgstr "Автоподбор проверяет только перечисленные здесь сайты."

msgid "Autotune history"
msgstr "История автоподбора"

msgid "Autotune is off. To apply the recommendation, switch to \"Recommendations only\" and apply it here, or to \"Automatic\"."
msgstr "Автоподбор выключен. Чтобы применить рекомендацию, включите режим «Только рекомендации» и примените её здесь или включите режим «Автоматически»."

msgid "Autotune mode changed"
msgstr "Изменён режим автоподбора"

msgid "Autotune policy"
msgstr "Политика автоподбора"

msgid "Autotune recommendation confirmed"
msgstr "Рекомендация автоподбора подтверждена"

msgid "Autotune run"
msgstr "Запуск автоподбора"

msgid "Autotune state is unavailable"
msgstr "Состояние автоподбора недоступно"

msgid "Autotune: %s applied automatically"
msgstr "Автоподбор: %s применена автоматически"

msgid "Autotune: %s applied manually"
msgstr "Автоподбор: %s применена вручную"

msgid "Autotune: automatic apply"
msgstr "Автоподбор: автоматическое применение"

msgid "Autotune: automatic apply of %s"
msgstr "Автоподбор: автоматическое применение %s"

msgid "Autotune: manual apply"
msgstr "Автоподбор: ручное применение"

msgid "Autotune: manual apply of %s"
msgstr "Автоподбор: ручное применение %s"

